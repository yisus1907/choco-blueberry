---
import Layout from "../layouts/Layout.astro";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Beneficios from "../components/Beneficios.astro";
import Productos from "../components/Productos.astro";
---

<Layout title="Choco Blueberry">


  <Header />


  <main>


    <Hero />


    <Beneficios />


    <Productos />



    <section id="contacto" class="contacto">


      <div class="container">


        <h2>
          Realiza tu pedido
        </h2>


        <p>
          Disfruta arándanos frescos directamente
          del Chocó Andino.
        </p>


        <a href="#" class="btn">
          Contactar WhatsApp
        </a>


      </div>


    </section>


  </main>



  <footer>


    <div class="container">


      <h3>
        Choco Blueberry
      </h3>


      <p>
        El sabor natural del Chocó Andino.
      </p>


      <p>
        © 2026 Todos los derechos reservados.
      </p>


    </div>


  </footer>



</Layout>