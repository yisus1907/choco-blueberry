---
const base = import.meta.env.BASE_URL;
---
<footer class="footer">


  <div class="container">


    <div class="contenido">


      <div class="marca">


        <img 
        src={`${import.meta.env.BASE_URL}img/logo.png`}
        alt="Choco Blueberry"
        >


        <p>
          Gracias por ser parte de este sueño.
        </p>


      </div>



      <div class="calidad">


        <div class="item">

          <span>🌿</span>

          <div>

            <h4>100% orgánicos</h4>

            <p>
              Cultivados naturalmente.
            </p>

          </div>

        </div>



        <div class="item">

          <span>❤️</span>

          <div>

            <h4>Sin químicos</h4>

            <p>
              Cuidamos la calidad de cada fruto.
            </p>

          </div>

        </div>



        <div class="item">

          <span>🛡️</span>

          <div>

            <h4>Producto de calidad</h4>

            <p>
              Seleccionado para nuestros clientes.
            </p>

          </div>

        </div>


      </div>



      <div class="redes">


        <h3>
          Síguenos
        </h3>

<a 
  href="https://www.facebook.com/arandanossmb"
  target="_blank"
  rel="noopener noreferrer"
>
  Facebook
</a>




<a 
  href="https://wa.me/593994960381?text=Hola,%20quiero%20información%20sobre%20los%20arándanos"
  target="_blank"
  rel="noopener noreferrer"
>
  💬 WhatsApp
</a>


      </div>


    </div>



    <div class="derechos">


      <p>
        © 2026 Choco Blueberry | Todos los derechos reservados.
      </p>


    </div>


  </div>


</footer>



<style>

.footer{

background:#173d20;

padding:70px 0 20px;

color:white;

}



.container{

width:90%;

max-width:1200px;

margin:auto;

}



.contenido{

display:grid;

grid-template-columns:1.2fr 1fr 1fr;

gap:40px;

}



.marca img{

width:200px;

margin-bottom:20px;

}



.marca p{

font-size:20px;

}



.calidad .item{

display:flex;

gap:15px;

margin-bottom:25px;

align-items:center;

}



.item span{

font-size:35px;

}



.item h4{

margin:0;

font-size:20px;

}



.item p{

margin:5px 0;

color:#d7e8d7;

}



.redes{

display:flex;

flex-direction:column;

gap:15px;

}



.redes h3{

font-size:25px;

}



.redes a{

color:white;

text-decoration:none;

font-size:18px;

transition:.3s;

}



.redes a:hover{

color:#b8e986;

}



.derechos{

border-top:1px solid rgba(255,255,255,.3);

margin-top:40px;

padding-top:20px;

text-align:center;

}



/* TABLET */

@media(max-width:900px){


.contenido{

grid-template-columns:1fr;

text-align:center;

}



.calidad .item{

justify-content:center;

}


}



/* CELULAR */

@media(max-width:600px){


.footer{

padding:40px 0 15px;

}



.container{

width:88%;

}



.contenido{

gap:20px;

}



.marca img{

width:150px;

margin-bottom:10px;

}



.marca p{

font-size:15px;

margin:0 0 20px;

}



.calidad .item{

display:flex;

flex-direction:row;

justify-content:center;

align-items:center;

gap:10px;

margin-bottom:15px;

}



.item span{

font-size:26px;

}



.item h4{

font-size:16px;

}



.item p{

font-size:13px;

margin:2px 0;

}



.redes{

margin-top:15px;

gap:10px;

}



.redes h3{

font-size:20px;

margin:0 0 5px;

}



.redes a{

font-size:16px;

}



.derechos{

margin-top:25px;

padding-top:15px;

}



.derechos p{

font-size:13px;

line-height:1.4;

margin:0;

}


}



/* CELULARES PEQUEÑOS */

@media(max-width:400px){


.marca img{

width:135px;

}



.item h4{

font-size:15px;

}



.item p{

font-size:12px;

}



.redes a{

font-size:15px;

}


}


</style>