---
const base = import.meta.env.BASE_URL;
---
<footer class="footer">


  <div class="container">


    <div class="contenido">


      <div class="marca">


        <img 
        src={`${import.meta.env.BASE_URL}img/logo.png`}
        alt="Choco Blueberry"
        >


        <p>
          Gracias por ser parte de este sueño.
        </p>


      </div>



      <div class="calidad">


        <div class="item">

          <span>🌿</span>

          <div>

            <h4>100% orgánicos</h4>

            <p>
              Cultivados naturalmente.
            </p>

          </div>

        </div>



        <div class="item">

          <span>❤️</span>

          <div>

            <h4>Sin químicos</h4>

            <p>
              Cuidamos la calidad de cada fruto.
            </p>

          </div>

        </div>



        <div class="item">

          <span>🛡️</span>

          <div>

            <h4>Producto de calidad</h4>

            <p>
              Seleccionado para nuestros clientes.
            </p>

          </div>

        </div>


      </div>



      <div class="redes">


        <h3>
          Síguenos
        </h3>


        <a href="#">
          📘 Facebook
        </a>


        <a href="#">
          📷 Instagram
        </a>


        <a href="#">
          💬 WhatsApp
        </a>


      </div>


    </div>



    <div class="derechos">


      <p>
        © 2026 Choco Blueberry | Todos los derechos reservados.
      </p>


    </div>


  </div>


</footer>



<style>

.footer{

background:#173d20;

padding:70px 0 20px;

color:white;

}



.container{

width:90%;

max-width:1200px;

margin:auto;

}



.contenido{

display:grid;

grid-template-columns:1.2fr 1fr 1fr;

gap:40px;

}



.marca img{

width:200px;

margin-bottom:20px;

}



.marca p{

font-size:20px;

}



.calidad .item{

display:flex;

gap:15px;

margin-bottom:25px;

align-items:center;

}



.item span{

font-size:35px;

}



.item h4{

margin:0;

font-size:20px;

}



.item p{

margin:5px 0;

color:#d7e8d7;

}



.redes{

display:flex;

flex-direction:column;

gap:15px;

}



.redes h3{

font-size:25px;

}



.redes a{

color:white;

text-decoration:none;

font-size:18px;

}



.redes a:hover{

color:#b8e986;

}



.derechos{

border-top:1px solid rgba(255,255,255,.3);

margin-top:40px;

padding-top:20px;

text-align:center;

}



@media(max-width:900px){

.contenido{

grid-template-columns:1fr;

text-align:center;

}


.calidad .item{

justify-content:center;

}


}

</style>