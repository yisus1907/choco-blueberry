---
const base = import.meta.env.BASE_URL;
---
<section class="contacto" id="contacto">

  <!-- formas decorativas -->
  <div class="forma forma1"></div>
  <div class="forma forma2"></div>


  <div class="container">


    <div class="contenido">


      <div class="texto">

        <h2>
          Contáctanos
        </h2>


        <h3>
          Lleva la frescura del Chocó Andino hasta tu mesa
        </h3>


        <p>
          Realiza tu pedido y disfruta de arándanos frescos,
          naturales y cultivados con cuidado.
        </p>



        <div class="botones">


<a 
  href="https://wa.me/593994960381?text=Hola,%20quiero%20información%20sobre%20los%20arándanos"
  class="btn"
  target="_blank"
>
  WhatsApp
</a>



<a 
  href="https://www.facebook.com/arandanossmb/"
  target="_blank"
  class="btn"
>
  Facebook
</a>



        </div>


      </div>




      <div class="imagen">


     <img src={`${base}img/contacto.jpg`} alt="Contacto Choco Blueberry">


      </div>



    </div>


  </div>


</section>



<style>

.contacto{

position:relative;
overflow:hidden;
padding:100px 0;
background:#EEF6EA;

}



.container{

width:90%;
max-width:1200px;
margin:auto;
position:relative;
z-index:2;

}



.contenido{

display:grid;
grid-template-columns:1fr 1fr;
gap:60px;
align-items:center;

}



.texto h2{

font-size:45px;
color:#3F6B45;
margin-bottom:15px;

}



.texto h3{

font-size:25px;
color:#7A5735;

}



.texto p{

font-size:18px;
line-height:1.7;
color:#555;
margin-top:25px;

}



.botones{

display:flex;
gap:15px;
margin-top:35px;
flex-wrap:wrap;

}



.botones a{

padding:14px 30px;

border-radius:30px;

color:white;

text-decoration:none;

font-weight:bold;

transition:.3s;

display:inline-block;

}



/* BOTONES */

.btn{

background:#6B4AA5;

}



.btn:first-child{

background:#4CAF70;

}



.btn:last-child{

background:#5272B8;

}



.botones a:hover{

transform:translateY(-5px);

}



/* IMAGEN */

.imagen img{

width:100%;

height:420px;

object-fit:cover;

border-radius:40px;

box-shadow:0 15px 35px rgba(0,0,0,.12);

}



/* FORMAS */

.forma{

position:absolute;

border-radius:60% 40% 50% 50%;

opacity:.7;

}



.forma1{

width:260px;

height:260px;

background:#D7EBCB;

right:-80px;

top:-70px;

}



.forma2{

width:180px;

height:180px;

background:#CFE0FA;

left:-60px;

bottom:-40px;

}



/* TABLET */

@media(max-width:900px){


.contenido{

grid-template-columns:1fr;

gap:40px;

}



.texto{

text-align:center;

}



.botones{

justify-content:center;

}



}



/* CELULAR */

@media(max-width:600px){


.contacto{

padding:70px 0;

}



.container{

width:88%;

}



.texto h2{

font-size:34px;

}



.texto h3{

font-size:21px;

line-height:1.4;

}



.texto p{

font-size:16px;

}



.botones{

flex-direction:column;

align-items:center;

width:100%;

}



.botones a{

width:85%;

text-align:center;

padding:15px;

}



.imagen img{

height:300px;

border-radius:25px;

}



}



/* CELULARES PEQUEÑOS */

@media(max-width:400px){


.botones a{

width:100%;

}



.imagen img{

height:260px;

}


}

</style>