---
const base = import.meta.env.BASE_URL;
---

<header class="header">

  <div class="container nav">

    <div class="logo">
      <a href="/">
        <img src={`${base}img/logo.png`} alt="Choco Blueberry">
      </a>
    </div>


    <nav>
      <a href="#inicio">Inicio</a>
      <a href="#nosotros">Nosotros</a>
      <a href="#productos">Productos</a>
      <a href="#contacto">Contacto</a>
    </nav>


    <a 
      class="btn" 
      href="https://wa.me/593994960381?text=Hola,%20quiero%20realizar%20un%20pedido%20de%20arándanos"
      target="_blank"
    >
      Comprar ahora
    </a>


  </div>

</header>


<style>

.header{

position:absolute;
top:0;
left:0;
width:100%;
z-index:10;

}


.nav{

height:120px;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 30px;

}


.logo img{

width:240px;
height:auto;
display:block;
filter:drop-shadow(0 8px 15px rgba(0,0,0,.35));
transition:.3s ease;

}


.logo img:hover{

transform:scale(1.08);

}


nav{

display:flex;
gap:30px;

}


nav a{

color:white;
font-weight:500;
text-decoration:none;
transition:.3s;

}


nav a:hover{

opacity:.8;

}



.btn{

background:#5530a8;
color:white;
padding:12px 25px;
border-radius:30px;
text-decoration:none;
white-space:nowrap;

}



/* CELULAR */

@media(max-width:800px){


.nav{

height:90px;
padding:0 15px;

}


.logo img{

width:130px;

}


nav{

display:none;

}


.btn{

padding:10px 15px;
font-size:14px;

}


}



@media(max-width:400px){


.logo img{

width:110px;

}


.btn{

padding:9px 12px;
font-size:13px;

}


}



</style>